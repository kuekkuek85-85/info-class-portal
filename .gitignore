# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어 있는 템플릿은 올린다 — 새 환경에서 무엇을 채워야 하는지 알려면 필요하다
!.env.example

# 학생 개인정보 — 절대 커밋하지 않는다.
# 명렬표(학번+이름)는 앱에서 교사 화면으로 업로드하는 것이지 저장소에 두는 자료가 아니다.
*.xlsx
*.xls
명렬*.csv
roster*.csv
/private/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 리허설·정리용 임시 스크립트 (수업 데이터를 손대므로 저장소에 남기지 않는다)
*.tmp.ts
*.tmp.mjs
# 커밋 메시지를 파일로 넘길 때 쓰는 자리 (한글이 셸에서 깨져서 이렇게 쓴다)
*.tmp.txt
