# ---------------------------------------------------------------------------
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 git 에 올라가지 않습니다.
# Vercel 배포 시에는 같은 이름으로 프로젝트 환경변수에 등록합니다.
# ---------------------------------------------------------------------------

# --- Firebase 웹 앱 (교사 Google 로그인용, 브라우저에 노출됨) -----------------
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 > SDK 설정 및 구성
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase 서비스 계정 (서버 전용, 절대 브라우저에 노출하지 말 것) ---------
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 (JSON 다운로드)
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# JSON 의 private_key 값을 통째로 붙여넣습니다. 줄바꿈은 \n 으로 두어도 됩니다.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- 세션 서명 키 (32자 이상) ------------------------------------------------
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- 교사 계정 허용 목록 (쉼표로 구분) ---------------------------------------
# 여기 없는 Google 계정은 로그인해도 거부됩니다. 비워 두면 아무도 들어올 수 없습니다.
TEACHER_EMAILS=teacher@example.com

# --- Gemini (서버 전용) ------------------------------------------------------
# AI 검토 질문, 감정 렌즈, 수행평가 오탈자 찾기에 씁니다.
#
# NEXT_PUBLIC_ 을 절대 붙이지 마세요. 붙이면 브라우저 번들에 키가 그대로 박히고,
# 하필 이 앱을 쓰는 것이 개발자도구를 여는 정보 수업 학생들입니다.
#
# 비워 두어도 앱은 돌아갑니다 — AI 자리는 고정 질문으로 내려갑니다 (ai-review.ts).
GEMINI_API_KEY=
# 비우면 gemini-flash-latest 를 씁니다. 바꾸기 전에 반드시 실제로 불러 보세요 —
# gemini-2.5-flash 는 모델 목록에 있는데도 생성 요청에서 404 로 떨어집니다.
# 잘못 넣으면 전원이 고정 질문으로 내려가는데 학생 화면에는 아무 표시가 안 납니다.
GEMINI_MODEL=

# --- 캔바 학교 팀 초대 주소 (선택과목 시드가 읽습니다) -----------------------
# 주소에 붙은 토큰만 있으면 누구나 학교 캔바 팀에 들어옵니다. 저장소가 공개라
# 코드에 적지 않고 여기서만 읽습니다. 분반별 주소가 없으면 기본 주소로 물러납니다.
CANVA_INVITE_URL=
CANVA_INVITE_TUE_1=
CANVA_INVITE_TUE_2=
CANVA_INVITE_THU_1=
CANVA_INVITE_THU_2=
